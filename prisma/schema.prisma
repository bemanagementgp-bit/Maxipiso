// ==================== ENUMS ====================

enum UserRole {
  ADMIN
  VIEWER
}

enum ChangeType {
  CREATE
  UPDATE
  DELETE
}

enum AuthEventType {
  LOGIN_OK
  LOGIN_FAIL
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  ROLE_CHANGED
  TOTP_ENABLED
  TOTP_DISABLED
  TOTP_FAIL
}

// ==================== HERO MEDIA ====================

model HeroMedia {
  id        String   @id @default(cuid())
  type      String   // "image" | "video"
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("hero_media")
}
