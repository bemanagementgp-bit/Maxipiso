// ==================== ENUMS ====================

enum UserRole {
  ADMIN
  VIEWER
}

enum ChangeType {
  CREATE
  UPDATE
  DELETE
}

enum AuthEventType {
  LOGIN_OK
  LOGIN_FAIL
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  ROLE_CHANGED
  TOTP_ENABLED
  TOTP_DISABLED
  TOTP_FAIL
}

// ==================== LEADS DEL CHATBOT ====================
// Antes de esto los datos que "Nacho" recolectaba (nombre, WhatsApp, email)
// solo viajaban dentro del texto del mensaje de WhatsApp y quedaban en el
// localStorage del visitante: no se guardaba nada del lado del servidor.

model Lead {
  id                  String     @id @default(cuid())
  nombre              String
  email               String?
  telefono            String
  telefonoNormalizado String     @unique
  mensaje             String?
  origenUrl           String?
  userAgent           String?
  interacciones       Int        @default(1)
  estado              LeadEstado @default(NUEVO)
  notas               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([estado])
  @@index([createdAt])
  @@map("leads")
}

enum LeadEstado {
  NUEVO
  EN_CONTACTO
  COMPRO
  DESCARTADO
}

/// Etiqueta que se dibuja encima de la foto de portada de un producto.
///
/// Es una tabla y no una lista en el codigo porque el catalogo de stickers
/// cambia con la campana comercial: hoy "Oferta" y "Mas vendido", manana otra
/// cosa. Se administran desde /panel/stickers sin tocar el codigo ni deployar.
///
/// Un sticker es una imagen (banderas, logos: no se pueden dibujar con texto) o
/// una etiqueta de texto con colores (Oferta, Novedad: no necesitan diseno).
model Sticker {
  id         String   @id @default(cuid())
  /// Como se llama en el panel. Es lo que ve quien carga el producto.
  nombre     String
  /// "imagen" | "texto"
  tipo       String   @default("texto")
  /// Solo para tipo = "imagen".
  imagenUrl  String?
  /// Solo para tipo = "texto".
  texto      String?
  colorFondo String?
  colorTexto String?
  /// Esquina de la foto: "arriba-izq" | "arriba-der" | "abajo-izq" | "abajo-der"
  posicion   String   @default("arriba-izq")
  /// Orden dentro de la esquina, y en el selector del ABM.
  orden      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@map("stickers")
}

/// Una de las cards de "Nuestras lineas de productos" del home.
///
/// Existe como tabla porque la portada es lo que mas cambia del sitio: cada
/// campana trae fotos nuevas, y hasta ahora cada cambio era editar codigo y
/// deployar. El `slug` es la categoria del catalogo a la que lleva la card, y
/// es lo que ancla la fila: el icono sigue viviendo en el codigo porque es un
/// componente, no un dato.
model LineaHome {
  slug      String   @id
  label     String
  imagenUrl String
  orden     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("lineas_home")
}
