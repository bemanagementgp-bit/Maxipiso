// This is your Prisma schema file for MaxiPiso Admin Panel
// Database: Turso (libSQL / SQLite)
// Schema v2 — Tablas separadas por categoría de producto

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USER MODELS (sin cambios) ====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(VIEWER)

  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime  @default(now())
  mustChangePassword Boolean   @default(false)

  totpSecret      String?
  totpEnabled     Boolean @default(false)
  totpBackupCodes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changeLogs ChangeLog[]
  sessions   Session[]
  authEvents AuthEvent[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model AuthEvent {
  id        String        @id @default(cuid())
  type      AuthEventType
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  ip        String?
  userAgent String?
  metadata  String?
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("auth_events")
}

// ==================== AUDITORÍA (polimórfica) ====================
// tablaNombre identifica la tabla origen (pisos_flotantes, maderas, etc.)
// entidadId   es el id del registro en esa tabla

model ChangeLog {
  id            String     @id @default(cuid())
  tablaNombre   String
  entidadId     String
  usuarioId     String
  usuario       User       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  campo         String
  valorAnterior String?
  valorNuevo    String?
  tipo          ChangeType
  fechaCambio   DateTime   @default(now())

  @@index([tablaNombre, entidadId])
  @@index([usuarioId])
  @@index([fechaCambio])
  @@map("change_logs")
}

// ==================== CATEGORÍAS DE PRODUCTOS ====================

// ── 1. PISOS FLOTANTES ─────────────────────────────────────────
model PisoFlotante {
  id                  String   @id @default(cuid())
  sku                 String   @unique
  categoriaPrincipal  String?
  categoriaSecundaria String?
  categoriaTerciaria  String?
  tipoProducto        String?
  origen              String?
  nombre              String
  codigo              String?
  marca               String
  linea               String?
  tipoDeUso           String?
  espesor             String?
  espesorUm           String?
  abrasion            String?
  mantoIncorporado    String?
  bisel               String?
  tono                String?
  ancho               String?
  anchoUm             String?
  largo               String?
  largoUm             String?
  base                String?
  baseUm              String?
  tablasPorCaja       Int?
  precioM2            Float?
  moneda              String?
  precioCaja          Float?
  pesoCaja            Float?
  cajasPallet         Int?
  pesoPallet          Float?
  stock               Int?
  imagenes            String? // JSON array de URLs
  stickers            String? // JSON array de ids de Sticker
  complementarios     String? // JSON array de ids de productos
  precioEnvioCaja     Float?
  garantia            String?
  fichaTecnica        String?
  archivoInstalacion  String?
  descripcion         String?
  metadatos           String? // JSON key-value extra
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([sku])
  @@index([marca])
  @@index([isActive])
  @@map("pisos_flotantes")
}

