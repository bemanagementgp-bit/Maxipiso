# ─── Base de datos (Turso / libSQL) ──────────────────────────────────────────
# En local podés usar SQLite: DATABASE_URL="file:./dev.db"
DATABASE_URL="libsql://tu-base.turso.io"
DATABASE_AUTH_TOKEN=""

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
# OJO: usar NEXTAUTH_SECRET, no AUTH_SECRET. El middleware lee solo esta.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# URL publica de la app. Se usa para validar Origin en las mutaciones y para el sitemap.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── 2FA ─────────────────────────────────────────────────────────────────────
# 64 caracteres hex (32 bytes). Obligatoria en produccion.
# Generar con: openssl rand -hex 32
TOTP_ENC_KEY=""

# ─── Servicios externos (opcionales) ─────────────────────────────────────────
# Sin GROQ_API_KEY el chatbot devuelve 503.
GROQ_API_KEY=""
# Sin RESEND_API_KEY el formulario de contacto devuelve 503.
RESEND_API_KEY=""

# ─── Storage de imagenes (Cloudinary) ────────────────────────────────────────
# Sin configurar se usa el disco local, que sirve en desarrollo pero en Vercel
# es de solo lectura: ahi los uploads responden 503 con un mensaje explicito.
#
# Sirven las dos formas, elegi UNA:
#
# 1) La variable unica que da el dashboard (Settings → API Keys). Es la mas
#    comoda: se pega tal cual, reemplazando los placeholders por los valores
#    reales de la key.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@dnaom2evd"
#
# 2) Las tres separadas. Tienen prioridad sobre CLOUDINARY_URL, asi que sirven
#    para sobreescribir una sola sin tocar el resto.
# CLOUDINARY_CLOUD_NAME="dnaom2evd"
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ─── Seed del admin inicial (solo para `npm run db:seed`) ────────────────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
